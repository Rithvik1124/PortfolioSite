---

const projects = [
    {
        title: "eBPF Endpoint Detection & Response",
        description:
            "eBPF-powered Linux EDR system written in Rust for real-time kernel telemetry collection, analysis, and security event detection.",
        topics: ["Rust", "Linux", "eBPF", "Systems Design"]
    },
    {
        title: "DLP Proxy",
        description:
            "A request-interception proxy designed to prevent sensitive data leakage to third-party LLM APIs.",
        topics: ["Python", "MITMProxy", "OCR"]
    },
    {
        title: "",
        description:
            "Third project placeholder.",
        topics: ["Python", "ML", "Security"]
    }
];

---

<section class="projects">

    <div class="projects-title">
        <p>Stuff I've made:</p>
    </div>

    <div class="controls">
        <button id="prev">← Prev</button>
        <button id="next">Next →</button>
    </div>

    <div class="viewport">

        <div class="track">

            {projects.map((project) => (

                <article class="card">

                    <h2>{project.title}</h2>

                    <p>{project.description}</p>

                    <div class="topics">

                        {project.topics.map((topic) => (

                            <span>{topic}</span>

                        ))}

                    </div>

                </article>

            ))}

        </div>

    </div>

</section>

<script>

let current = 0;

const track = document.querySelector(".track");
const cards = document.querySelectorAll(".card");

const prev = document.getElementById("prev");
const next = document.getElementById("next");

function updateCarousel() {

    if (!track || cards.length === 0) return;

    const cardWidth = cards[0].getBoundingClientRect().width;
    const gap = 80; // Same as CSS gap

    track.style.transform = `translateX(-${current * (cardWidth + gap)}px)`;

}

next?.addEventListener("click", () => {

    current = (current + 1) % cards.length;
    updateCarousel();

});

prev?.addEventListener("click", () => {

    current = (current - 1 + cards.length) % cards.length;
    updateCarousel();

});

window.addEventListener("resize", updateCarousel);

updateCarousel();

</script>

<style>

.projects{

    position:relative;

    width:100%;
    height:650px;


    background:url("/projects.png") center/cover no-repeat;
    background-position: bottom;
    overflow:hidden;

}
.projects::before{
    top: 0;

    background: linear-gradient(
        to bottom,
        rgba(0,0,0,.55),
        rgba(0,0,0,0)
    );
}
.projects::after{
    bottom: 0;

    background: linear-gradient(
        to top,
        rgba(0,0,0,.55),
        rgba(0,0,0,0)
    );
}

.projects::before,
.projects::after{
    content: "";

    position: absolute;
    left: 0;

    width: 100%;
    height: 100px;

    pointer-events: none;
    z-index: 10;
}
.controls{
    position:absolute;
    top:25px;
    right:25px;
    z-index:100;
}

.viewport{

    position:absolute;

    inset:80px 30px 30px 30px;

    overflow:hidden;

    padding-left:calc((100% - 750px)/2);

}

.projects-title{

    position: absolute;

    top: 15px;
    left: 25px;

    margin: 0;
    padding: 0.1rem 0.5rem;

    font-size: 2rem;
    font-weight: 700;

    color: white;

    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;

    text-shadow: 2px 2px 0 black;
    z-index:100;

}

.controls button{

    padding:.7rem 1.3rem;

    border:none;

    border-radius:999px;

    cursor:pointer;

    font-weight:bold;
    color: white;
    z-index:100;


}
.track{

    display:flex;
    gap:80px;

    transition:transform .45s ease;

    align-items:center;

}
.card{

    flex:0 0 750px;

    height:420px;

    background:#fff8d6;

    padding:3rem;

    box-sizing:border-box;

    border-radius:20px;

    border:4px solid #222;

}
.card h2{

    margin-top:0;

    font-size:2.4rem;

}

.card p{

    line-height:1.8;

    margin:2rem 0;

}

.topics{

    display:flex;

    flex-wrap:wrap;

    gap:10px;

}

.topics span{

    background:#ffffff;

    border:2px solid #222;

    border-radius:999px;

    padding:.5rem 1rem;

    font-size:.9rem;

}

</style>