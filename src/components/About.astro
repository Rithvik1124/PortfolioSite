<section class="about" id="about">

    <h2 class="about-title">About Me</h2>

    <div class="cards">

        <article class="card card-1">
            <h3>Who am I?</h3>

            <p>
                A Computer Science student who
                enjoys building things related to cybersecurity, Linux and systems
                programming. I spend most of my time experimenting with Rust,
                eBPF, detection engineering and backend development.
            </p>

            <p>
                I like taking ideas from "this would be cool" to something that
                actually works.
            </p>
        </article>

        <article class="card card-2">

            <h3>Currently...</h3>

            <ul>
                <li>🔒 Building a Linux EDR using Rust + eBPF</li>
                <li>🦀 Learning more Rust every day</li>
                <li>🐧 Diving deep inside Linux</li>
                <li>📚 Exploring malware analysis & DFIR</li>
                <li>☕ Drinking unhealthy amounts of coffee</li>
            </ul>

        </article>

    </div>

</section>

<style>

.about{

    position:relative;

    width:100%;
    min-height:700px;

    background:url("/about.png") bottom left;

    overflow:hidden;

}

.about::before{
    top: 0;

    background: linear-gradient(
        to bottom,
        rgba(0,0,0,.55),
        rgba(0,0,0,0)
    );
}
.about::after{
    bottom: 0;

    background: linear-gradient(
        to top,
        rgba(0,0,0,.55),
        rgba(0,0,0,0)
    );
}

.about::before,
.about::after{
    content: "";

    position: absolute;
    left: 0;

    width: 100%;
    height: 100px;

    pointer-events: none;
    z-index: 10;
}



.about-title{

    position:absolute;

    top:35px;
    left:35px;

    margin:0;

    font-size:2.4rem;

    color:white;
    z-index: 100;
    text-shadow:4px 4px 0 black;

}

.cards{

    width:100%;

    display:flex;
    justify-content:center;
    align-items:center;

    gap:3rem;

    padding-top:150px;

}

.card{

    width:460px;
    min-height:330px;

    background:#fff6d5;

    border:4px solid #222;
    border-radius:22px;

    box-shadow:8px 8px 0 #222;

    padding:2rem;

    transition:.25s ease;

}

.card:hover{

    transform:translateY(-8px);

}

.card-1{

    transform:rotate(-3deg);

}

.card-2{

    transform:rotate(2deg);

}

.card h3{

    margin-top:0;

}

.card p{

    line-height:1.7;

}

.card ul{

    margin-top:1rem;
    padding-left:1.2rem;

    line-height:2;

}

@media(max-width:1000px){

    .cards{

        flex-direction:column;

        padding:140px 1rem 3rem;

    }

    .card{

        width:min(90%,450px);

        transform:none !important;

    }

}

</style>