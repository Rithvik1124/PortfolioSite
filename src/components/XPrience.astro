---
const experiences = [
  {
    role: "Cybersecurity Intern",
    company: "National Informatics Centre (NIC)",
    duration: "May 2025",
    description:
      "Worked with the SOC team using Microsoft Sentinel, Elastic and KACE. Assisted in monitoring, log analysis and incident investigation.",
  },
  {
    role: "Python Development Intern",
    company: "Tealbox Digital",
    duration: "2024",
    description:
      "Developed Python automation for web scraping, SEO analysis and AI-assisted content generation using OpenAI APIs.",
  },
  
];

// Get it? XPrience? Imma use that joke everywhere now

---



<section class="experience" id="experience">

    <h2 class="experience-title">Experience</h2>

    <div class="cards">

        {experiences.map((exp, index) => (
            <article class={`card card-${index + 1}`}>
                <h3>{exp.role}</h3>
                <h4>{exp.company}</h4>
                <span>{exp.duration}</span>
                <p>{exp.description}</p>
            </article>
        ))}

    </div>

</section>

<style>

.experience{

    position:relative;
    width:100%;
    min-height:900px;

    background:url("/xprience.png") center/cover no-repeat;

    overflow:hidden;

}
.experience::before{
    top: 0;

    background: linear-gradient(
        to bottom,
        rgba(0,0,0,.55),
        rgba(0,0,0,0)
    );
}
.experience::after{
    bottom: 0;

    background: linear-gradient(
        to top,
        rgba(0,0,0,.55),
        rgba(0,0,0,0)
    );
}

.experience::before,
.experience::after{
    content: "";

    position: absolute;
    left: 0;

    width: 100%;
    height: 100px;

    pointer-events: none;
    z-index: 10;
}

.experience-title{

    position:absolute;

    top:40px;
    left:40px;

    font-size:2.4rem;
    color:white;
    font-weight:700;

    text-shadow:4px 4px 0 #000;

}
.cards{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:2rem;

    width:fit-content;
    margin:0 auto;

    padding-top:180px;
}

.card{

    position:relative;

    width:420px;

    background:#fff8d6;

    padding:1.8rem;

    border:4px solid #222;
    border-radius:22px;

    box-shadow:8px 8px 0 #222;

    transition:.25s ease;

}

.card:hover{

    transform:translateY(-10px) rotate(0deg);

}

.card h3{

    margin:0;

}

.card h4{

    margin:.35rem 0;

    color:#444;

}

.card span{

    font-size:.9rem;
    font-weight:bold;

    color:#666;

}

.card p{

    margin-top:1rem;

    line-height:1.6;

}

/* Diagonal layout */

.card-1{
    transform:rotate(-4deg);
    margin-top:-120px;
}

.card-2{
    transform:rotate(3deg);
    margin-top:60px;
}

.card-3{
    top: 470px;
    left: 180px;

    transform: rotate(-2deg);
}

@media(max-width:1100px){

    .cards{

        display:flex;
        flex-direction:column;
        align-items:center;
        gap:2rem;

        padding-top:140px;
        height:auto;

    }

    .card{

        position:static;
        transform:none;
        width:min(90%,420px);

    }

}

</style>